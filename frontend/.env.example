# Copy to .env.local and fill in from Supabase Dashboard → Project Settings → API.
# The publishable (anon) key is safe to expose in the browser; NEVER put the
# service_role / secret key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Independently deployed ANU TokTok frontend and management dashboard
VITE_TOKTOK_CUSTOMER_URL=
VITE_TOKTOK_ADMIN_URL=
